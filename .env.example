# Render injects this at runtime. Never commit a real key.
GEMINI_KEY=your_gemini_api_key_here

# Optional. Models are tried in order when one is rate limited or overloaded.
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite

# Optional per-model timeout (Spring duration syntax).
# GEMINI_TIMEOUT=10s

# Optional. Render and most PaaS providers set PORT automatically.
# PORT=8080
